{
	"version": "2.0.0",
	"tasks": [
        {
            "label": "[Firmware] Build",
            "type": "shell",
            "command": "arduino-cli compile --fqbn esp32:esp32:esp32c3 D:\\Projets\\WateringSystem\\system",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [],
            "detail": "Compile firmware for ESP32-C3 without uploading."
        },
		{
            "label": "[Firmware] Build & Flash",
            "type": "shell",
            "command": "arduino-cli compile --fqbn esp32:esp32:esp32c3:UploadSpeed=921600 --upload -p COM14 D:\\Projets\\WateringSystem\\system",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [],
            "detail": "Full workflow: compile then upload firmware to ESP32-C3 on COM14."
        },
        {
            "command": "python find_esp.py",
            "group": "test",
            "label": "[Network] Find ESP IP",
            "type": "shell"
        },
        {
            "label": "[MQTT] Start Local Broker",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File MQTT/scripts/broker.ps1 start",
            "group": "build",
            "problemMatcher": [],
            "detail": "Start the local EMQX Docker Compose service."
        },
        {
            "label": "[MQTT] Stop Local Broker",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File MQTT/scripts/broker.ps1 stop",
            "problemMatcher": [],
            "detail": "Stop the local EMQX Docker Compose service."
        },
        {
            "label": "[MQTT] Broker Status",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File MQTT/scripts/broker.ps1 status",
            "problemMatcher": [],
            "detail": "Show local EMQX service status."
        },
        {
            "label": "[MQTT] Publish Subscribe Test",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File MQTT/scripts/broker.ps1 test; powershell -NoProfile -ExecutionPolicy Bypass -File MQTT/scripts/test.ps1",
            "group": "test",
            "problemMatcher": [],
            "detail": "Run an authenticated MQTTX publish/subscribe test."
        }
	]
}